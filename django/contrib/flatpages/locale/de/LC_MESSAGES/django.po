msgid "Advanced options"
msgstr "Erweiterte Optionen"

msgid "Flat Pages"
msgstr "Flache Seiten"

msgid "URL"
msgstr "URL"

msgid ""
"Example: '/about/contact/'. Make sure to have leading and trailing slashes."
msgstr ""
"Beispiel: „/about/contact/“. Stellen Sie sicher, dass ein führender und "
"abschließender Schrägstrich vorhanden ist."

msgid ""
"This value must contain only letters, numbers, dots, underscores, dashes, "
"slashes or tildes."
msgstr ""
"Dieser Wert darf nur Buchstaben, Zahlen, Punkte, Unterstriche, "
"Bindestriche, Schrägstriche oder Tilden enthalten."

msgid "URL is missing a leading slash."
msgstr "Die URL fehlt ein führender Schrägstrich."

msgid "URL is missing a trailing slash."
msgstr "Die URL fehlt ein abschließender Schrägstrich."

#, python-format
msgid "Flatpage with url %(url)s already exists for site %(site)s"
msgstr ""
"Eine Flatpage mit der URL %(url)s existiert bereits für die Seite %(site)s."

msgid "title"
msgstr "Titel"

msgid "content"
msgstr "Inhalt"

msgid "enable comments"
msgstr "Kommentare aktivieren"

msgid "template name"
msgstr "Name der Vorlage"

msgid ""
"Example: 'flatpages/contact_page.html'. If this isn't provided, the system "
"will use 'flatpages/default.html'."
msgstr ""
"Beispiel: „flatpages/contact_page.html“. Wenn dies nicht angegeben ist, "
"verwendet das System „flatpages/default.html“."

msgid "registration required"
msgstr "Registrierung erforderlich"

msgid "If this is checked, only logged-in users will be able to view the page."
msgstr ""
"Wenn dies aktiviert ist, können nur angemeldete Benutzer die Seite "
"einsehen."

msgid "sites"
msgstr "Webseiten"

msgid "flat page"
msgstr "Flache Seite"

msgid "flat pages"
msgstr "Flache Seiten"