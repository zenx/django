msgid "Template filters"
msgstr "Filtar šablona"

msgid "Template filter documentation"
msgstr "Dokumentacija filtera predloška"

msgid "Built-in filters"
msgstr "Filteri koji dolaze s okvirom"

#, python-format
msgid ""
"To use these filters, put <code>%(code)s</code> in your template before "
"using the filter."
msgstr ""
"Da biste koristili ove filtre, stavite <code>%(code)s</code> u svoju šablonu "
"prije korištenja filtra."

msgid "Template tags"
msgstr "Tagovi predloška"

msgid "Template tag documentation"
msgstr "Dokumentacija tagova šablona"

msgid "Built-in tags"
msgstr "Zadate oznake"

#, python-format
msgid ""
"To use these tags, put <code>%(code)s</code> in your template before using "
"the tag."
msgstr ""
"Da biste koristili ove oznake, stavite <code>%(code)s</code> u svoju šablonu "
"prije korištenja oznake."

