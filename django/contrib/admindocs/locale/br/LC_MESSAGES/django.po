msgstr "Filtradoù templat"

msgid "Template filter documentation"
msgstr "Dokumentadeg ar c'hwec'henn kempenn"

msgid "Built-in filters"
msgstr "Filtreoù en intra"

#, python-format
msgid ""
"To use these filters, put <code>%(code)s</code> in your template before "
"using the filter."
msgstr ""
"Da lârat an tolichoù-mañ, lakaat <code>%(code)s</code> en ho template a-raok "
"implijout an tolich."

msgid "Template tags"
msgstr "Tagoù templated"

msgid "Template tag documentation"
msgstr "Dokumentadeg yezhadur"

msgid "Built-in tags"
msgstr "Tagioù enlinenn"

#, python-format
msgid ""
"To use these tags, put <code>%(code)s</code> in your template before using "
"the tag."
msgstr ""
"Evit ulioù-se, roit <code>%(code)s</code> e vaš template a-raok implijout an "
"ulioù-se."

