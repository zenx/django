msgstr "ডকুমেন্টেশনে ফেরত যান"

msgid "Template filters"
msgstr "টেমপ্লেট ফিল্টার"

msgid "Template filter documentation"
msgstr "টেমপ্লেট ফিল্টার ডকুমেন্টেশন"

msgid "Built-in filters"
msgstr "বিল্ট-ইন ফিল্টার"

#, python-format
msgid ""
"To use these filters, put <code>%(code)s</code> in your template before "
"using the filter."
msgstr ""
"এই ফিল্টারগুলি ব্যবহার করতে, ফিল্টার ব্যবহারের আগে আপনার টেমপ্লেটে <code>%(code)s</code> দিন।"

msgid "Template tags"
msgstr "টেমপ্লেট ট্যাগ"

msgid "Template tag documentation"
msgstr "টেমপ্লেট ট্যাগ ডকুমেন্টেশন"

msgid "Built-in tags"
msgstr "বিল্ট-ইন ট্যাগ"

#, python-format
msgid ""
"To use these tags, put <code>%(code)s</code> in your template before using "
"the tag."
msgstr ""
"এই ট্যাগগুলি ব্যবহারের জন্য, আপনার টেমপ্লেটে ট্যাগ ব্যবহারের আগে <code>%(code)s</code> লিখুন।"

