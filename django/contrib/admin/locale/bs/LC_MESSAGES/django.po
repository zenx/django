msgstr "Greška na serveru <em>(500)</em>"

msgid ""
"There's been an error. It's been reported to the site administrators via "
"email and should be fixed shortly. Thanks for your patience."
msgstr ""
"Došlo je do greške. Prijavljeno je administratorima stranice putem e-pošte i "
"trebalo bi biti ispravljeno uskoro. Hvala na strpljenju."

msgid "Run the selected action"
msgstr "Pokreni odabranu radnju"

msgid "Go"
msgstr "Počni"

msgid "Click here to select the objects across all pages"
msgstr "Kliknite ovdje da izaberete objekte preko svih stranica"

