msgstr "%(name)s \"%(obj)s\" সফলতার সাথে মুছে ফেলা হয়েছে।"

#, python-format
msgid "%(name)s with ID \"%(key)s\" doesn't exist. Perhaps it was deleted?"
msgstr "%(name)s যার আইডি \"%(key)s\" নেই। হয়ত এটি মুছে ফেলা হয়েছে?"

