msgstr ""
"আপনি কি নিশ্চিত যে আপনি নির্বাচিত %(objects_name)s মুছে ফেলতে চান? নিম্নলিখিত সব বস্তু এবং তাদের সম্পর্কি"
"ত আইটেমগুলি মুছে ফেলা হবে:"

msgid "Change"
msgstr "পরিবর্তন"

msgid "Delete?"
msgstr "মুছে ফেলুন?"

