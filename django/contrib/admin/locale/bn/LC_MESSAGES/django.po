msgstr "{name} \"{obj}\" সফলভাবে যোগ করা হয়েছে।"

#, python-brace-format
msgid ""
"The {name} \"{obj}\" was changed successfully. You may edit it again below."
msgstr ""
"{name} \"{obj}\" সফলভাবে পরিবর্তিত হয়েছে। আপনি নীচে আবার এটি সম্পাদনা করতে পারেন।"

#, python-brace-format
msgid ""
"The {name} \"{obj}\" was changed successfully. You may add another {name} "
"below."
msgstr ""
"{name} \"{obj}\" সফলভাবে পরিবর্তিত হয়েছে। আপনি নীচে আরেকটি {name} যোগ করতে পারেন।"

#, python-brace-format
msgid "The {name} \"{obj}\" was changed successfully."
msgstr "{name} \"{obj}\" সফলভাবে পরিবর্তিত হয়েছে।"

msgid ""
"Items must be selected in order to perform actions on them. No items have "
"been changed."
msgstr "কাজ করার আগে বস্তুগুলিকে অবশ্যই চিহ্নিত করতে হবে। কোনো বস্তু পরিবর্তিত হয়নি।"

msgid "No action selected."
msgstr "কোনো কাজ "

#, python-format
