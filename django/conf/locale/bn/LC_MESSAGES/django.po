msgstr "বৈধ URL দিন"

msgid "Enter a valid integer."
msgstr "একটি বৈধ পূর্ণ সংখ্যা প্রবেশ করান।"

msgid "Enter a valid email address."
msgstr "একটি বৈধ ইমেইল ঠিকানা লিখুন."

#. Translators: "letters" means latin letters: a-z and A-Z.
msgid ""
"Enter a valid 'slug' consisting of letters, numbers, underscores or hyphens."
msgstr ""
"বৈধ ’slug' প্রবেশ করান যাতে শুধুমাত্র ইংরেজী বর্ণ, অঙ্ক, আন্ডারস্কোর অথবা হাইফেন "
"রয়েছে।"

msgid ""
"Enter a valid 'slug' consisting of Unicode letters, numbers, underscores, or "
"hyphens."
msgstr ""
"একটি বৈধ 'স্লাগ' প্রবেশ করুন যা ইউনিকোড অক্ষর, সংখ্যা, আন্ডারস্কোর বা হাইফেন এ তৈরি।"

msgid "Enter a valid IPv4 address."
msgstr "একটি বৈধ IPv4 ঠিকানা দিন।"

msgid "Enter a valid IPv6 address."
msgstr "একটি বৈধ IPv6 ঠিকানা টাইপ করুন।"

msgid "Enter a valid IPv4 or IPv6 address."
msgstr "একটি বৈধ IPv4 অথবা IPv6 ঠিকানা টাইপ করুন।"

msgid "Enter only digits separated by commas."
msgstr "শুধুমাত্র কমা দিয়ে সংখ্যা দিন।"

#, python-format
msgid "Ensure this value is %(limit_value)s (it is %(show_value)s)."
msgstr "সংখ্যাটির মান %(limit_value)s হতে হবে (এটা এখন %(show_value)s আছে)।"

#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "সংখ্যাটির মান %(limit_value)s এর চেয়ে ছোট বা সমান হতে হবে।"

#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "সংখ্যাটির মান %(limit_value)s এর চেয়ে বড় বা সমান হতে হবে।"

#, python-format
msgid ""
"Ensure this value has at least %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at least %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"এই মানটি অন্তত %(limit_value)d অক্ষর ধারণ করে তা নিশ্চিত করুন (এতে %(show_value)d)।"

#, python-format
msgid ""
"Ensure this value has at most %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at most %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"এটি সর্বাধিক %(limit_value)d অক্ষর ধারণ করে তা নিশ্চিত করুন (এতে %(show_value)d)।"

#, python-format
msgid "Ensure that there are no more than %(max)s digit in total."
msgid_plural "Ensure that there are no more than %(max)s digits in total."
msgstr[0] "মোটের চেয়ে বেশি %(max)s সংখ্যা থাকবে না তা নিশ্চিত করুন।"

#, python-format
msgid "Ensure that there are no more than %(max)s decimal place."
msgid_plural "Ensure that there are no more than %(max)s decimal places."
msgstr[0] "%(max)s দশমিক স্থান অতিক্রম করবে না তা নিশ্চিত করুন।"

#, python-format
msgid ""
"Ensure that there are no more than %(max)s digit before the decimal point."
msgid_plural ""
"Ensure that there are no more than %(max)s digits before the decimal point."
msgstr[0] "ডিসিমাল পয়েন্টের আগে %(max)s সংখ্যার বেশি থাকবে না তা নিশ্চিত করুন।"

#, python-format
msgid ""
"File extension '%(extension)s' is not allowed. Allowed extensions are: "
"'%(allowed_extensions)s'."
msgstr ""
"ফাইলের এক্সটেনশন '%(extension)s' অনুমোদিত নয়। অনুমোদিত এক্সটেনশনগুলি: "
"'%(allowed_extensions)s'।"

msgid "Null characters are not allowed."
msgstr "শূন্য অক্ষর অনুমোদিত নয়।"

msgid "and"
msgstr "এবং"

#, python-format
msgid "%(model_name)s with this %(field_labels)s already exists."
msgstr "%(field_labels)s সহ %(model_name)s ইতিমধ্যে বিদ্যমান।"

#, python-format
msgid "Value %(value)r is not a valid choice."
msgstr "মান %(value)r একটি বৈধ পছন্দ নয়।"

msgid "This field cannot be null."
msgstr "এর মান null হতে পারবে না।"

msgid "This field cannot be blank."
msgstr "এই ফিল্ডের মান ফাঁকা হতে পারে না"

#, python-format
msgid "%(model_name)s with this %(field_label)s already exists."
msgstr "%(field_label)s সহ %(model_name)s আরেকটি রয়েছে।"

#. Translators: The 'lookup_type' is one of 'date', 'year' or 'month'.
#. Eg: "Title must be unique for pub_date year"
#, python-format
msgid ""
"%(field_label)s must be unique for %(date_field_label)s %(lookup_type)s."
msgstr ""
"%(date_field_label)s %(lookup_type)s এর জন্য %(field_label)s অনন্য হতে হবে।"

#, python-format
msgid "Field of type: %(field_type)s"
msgstr "ফিল্ডের ধরণ: %(field_type)s"

msgid "Integer"
msgstr "ইন্টিজার"

#, python-format
msgid "'%(value)s' value must be an integer."
msgstr "'%(value)s' মানটি একটি পূর্ণসংখ্যা হতে হবে।"

msgid "Big (8 byte) integer"
msgstr "বিগ (৮ বাইট) ইন্টিজার"

#, python-format
msgid "'%(value)s' value must be either True or False."
msgstr "'%(value)s' মানটি বা True অথবা False হতে হবে।"

msgid "Boolean (Either True or False)"
msgstr "বুলিয়ান (হয় True অথবা False)"

#, python-format
msgid "String (up to %(max_length)s)"
msgstr "স্ট্রিং (সর্বোচ্চ %(max_length)s)"

msgid "Comma-separated integers"
msgstr "কমা দিয়ে আলাদা করা ইন্টিজার"

#, python-format
msgid ""
"'%(value)s' value has an invalid date format. It must be in YYYY-MM-DD "
"format."
msgstr ""
"'%(value)s' মানের তারিখের ফরম্যাট শুদ্ধ নয়। এটি YYYY-MM-DD ফরম্যাটে থাকতে হবে।"

#, python-format
msgid ""
"'%(value)s' value has the correct format (YYYY-MM-DD) but it is an invalid "
"date."
msgstr ""
"'%(value)s' মানের সঠিক ফরম্যাট (YYYY-MM-DD) রয়েছে তবে এটি একটি অবৈধ তারিখ।"

msgid "Date (without time)"
msgstr "তারিখ (সময় বাদে)"

#, python-format
msgid ""
"'%(value)s' value has an invalid format. It must be in YYYY-MM-DD HH:MM[:ss[."
"uuuuuu]][TZ] format."
msgstr ""
"'%(value)s' মানের অসঙ্গত ফরম্যাট রয়েছে। এটি YYYY-MM-DD HH:MM[:ss[.uuuuuu]][TZ] ফরম্যাটে "
"থাকতে হবে।"

#, python-format
msgid ""
"'%(value)s' value has the correct format (YYYY-MM-DD HH:MM[:ss[.uuuuuu]]"
"[TZ]) but it is an invalid date/time."
msgstr ""
"'%(value)s' মানের সঠিক ফরম্যাট (YYYY-MM-DD HH:MM[:ss[.uuuuuu]][TZ]) রয়েছে তবে এটি একটি "
"অবৈধ তারিখ/সময়।"

msgid "Date (with time)"
msgstr "তারিখ (সময় সহ)"

#, python-format
msgid "'%(value)s' value must be a decimal number."
msgstr "'%(value)s' মানটি একটি দশমিক সংখ্যা হতে হবে।"

msgid "Decimal number"
msgstr "দশমিক সংখ্যা"

#, python-format
msgid ""
"'%(value)s' value has an invalid format. It must be in [DD] [HH:[MM:]]ss[."
"uuuuuu] format."
msgstr ""
"'%(value)s' মানের একটি অসঙ্গত ফরম্যাট রয়েছে। এটি [DD] [HH:[MM:]]ss[.uuuuuu] ফরম্যাটে থাকতে "
"হবে।"

msgid "Duration"
msgstr "সময়কাল"

msgid "Email address"
msgstr "ইমেইল ঠিকানা"

msgid "File path"
msgstr "ফাইল পথ"

#, python-format
msgid "'%(value)s' value must be a float."
msgstr "'%(value)s' মানটি একটি ফ্লোট হতে হবে।"

msgid "Floating point number"
msgstr "ফ্লোটিং পয়েন্ট সংখ্যা"

msgid "IPv4 address"
msgstr "IPv4 ঠিকানা"

msgid "IP address"
msgstr "আইপি ঠিকানা"

#, python-format
msgid "'%(value)s' value must be either None, True or False."
msgstr "'%(value)s' মানটি None, True অথবা False এর মধ্যে একটি হতে হবে।"

msgid "Boolean (Either True, False or None)"
msgstr "বুলিয়ান (হয়  True, False অথবা None)"

msgid "Positive integer"
msgstr "পজিটিভ ইন্টিজার"

msgid "Positive small integer"
msgstr "পজিটিভ স্মল ইন্টিজার"

#, python-format
msgid "Slug (up to %(max_length)s)"
msgstr "স্লাগ (সর্বোচ্চ %(max_length)s)"

msgid "Small integer"
msgstr "স্মল ইন্টিজার"

msgid "Text"
msgstr "টেক্সট"

#, python-format
msgid ""
"'%(value)s' value has an invalid format. It must be in HH:MM[:ss[.uuuuuu]] "
"format."
msgstr ""
"'%(value)s' মানের একটি অসঙ্গত ফরম্যাট রয়েছে। এটি HH:MM[:ss[.uuuuuu]] ফরম্যাটে থাকতে হবে।"

#, python-format
msgid ""
"'%(value)s' value has the correct format (HH:MM[:ss[.uuuuuu]]) but it is an "
"invalid time."
msgstr ""
"'%(value)s' মানের সঠিক ফরম্যাট (HH:MM[:ss[.uuuuuu]]) রয়েছে তবে এটি একটি অসঙ্গত সময়।"

msgid "Time"
msgstr "সময়"

msgid "URL"
msgstr "ইউআরএল (URL)"

msgid "Raw binary data"
msgstr "র বাইনারি ডাটা"

#, python-format
msgid "'%(value)s' is not a valid UUID."
msgstr "'%(value)s' একটি বৈধ UUID নয়।"

msgid "File"
msgstr "ফাইল"

msgid "Image"
msgstr "ইমেজ"

#, python-format
msgid "%(model)s instance with %(field)s %(value)r does not exist."
